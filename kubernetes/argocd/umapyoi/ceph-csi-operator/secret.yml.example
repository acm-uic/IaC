apiVersion: v1
kind: Secret
metadata:
  name: ceph-csi-rbd
  namespace: ceph-csi-operator
type: Opaque
stringData:
  # The Ceph client ID without the "client." prefix.
  userID: REPLACE_WITH_CEPH_USER_ID
  userKey: REPLACE_WITH_CEPH_USER_KEY
  # Required only when encrypted RBD volumes are enabled.
  # encryptionPassphrase: REPLACE_WITH_ENCRYPTION_PASSPHRASE

